{
  "compilerOptions": {
    "target": "ES2020",
    // DOM only for the WHATWG globals this package uses (URLSearchParams);
    // it touches no document or window API and runs fine in Node and RN.
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.mts",
    "*.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
